# 构建产物：按 OPENTENBASE 开关生成，两个平台各一份，所以不入库
# （真源是 sql/*.sql 片段与 pg_graph_search.control.in）
pg_graph_search--*.sql
pg_graph_search.control

# 可移植版构建产物（本地/CI 用原生 PostgreSQL 验证时生成，不入库）
pg_graph_search--*-portable.sql
pg_graph_search-portable.control

# pg_regress 输出
test/results/
test/regression.diffs
test/regression.out
test/log/
