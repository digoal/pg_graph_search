# pg_graph_search — 属性图搜索扩展（元函数驱动）
#
#   本文件是模板：Makefile 按 OPENTENBASE 开关把 @SQL_MODE@ 替换掉，生成
#   pg_graph_search.control。生成物不入库（见 .gitignore）。
#
#   两平台差异只有 sql_mode 这一行：
#     OPENTENBASE=1（OpenTenBase）-> sql_mode = 'all'
#         OpenTenBase 的 check_extension_in_right_mode() 要求 control 里的 sql_mode
#         为 'all'，或与当前 SQL 模式匹配。缺省值是 'postgresql'
#         （见 src/backend/commands/extension.c 的 DEFAULT_EXT_SQL_MODE），
#         那样在 opentenbase_ora 兼容模式下无法 CREATE EXTENSION。
#     OPENTENBASE=0（原生 PostgreSQL，默认）-> 空
#         原生 PostgreSQL 把未知 control 参数当 ERROR：
#         `unrecognized parameter "sql_mode" in file ".../pg_graph_search.control"`，
#         所以原生 PG 版必须整行去掉。
#
#   schema = 'graph_search'：扩展自带 schema，元函数与注册表都在这里。
#   relocatable = false：生成对象统一用 schema 限定名，不依赖 search_path
#     （CN 与 DN 的 search_path 可能不同，这一点在分布式下很重要）。
comment = 'Property-graph search for PostgreSQL and OpenTenBase: a meta-function that generates concrete, parameterized graph search functions for any edge table'
default_version = '1.0.0'
relocatable = false
schema = 'graph_search'
@SQL_MODE@
